{
    "name": "@blocklify/preview",
    "version": "0.2.1",
    "description": "Blocklify frontend SDK: Content API client and live-preview React helpers for theme blocks.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        },
        "./preview": {
            "types": "./dist/preview.d.ts",
            "import": "./dist/preview.js"
        },
        "./starter": {
            "types": "./dist/starter.d.ts",
            "import": "./dist/starter.js"
        }
    },
    "files": [
        "dist",
        "starter",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BodhiMooij/blocklify-preview.git"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "prepublishOnly": "bun run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": false
        },
        "react-dom": {
            "optional": false
        }
    },
    "devDependencies": {
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "typescript": "^5"
    },
    "keywords": [
        "blocklify",
        "cms",
        "live-preview",
        "headless"
    ]
}
